#!/bin/bash

# ce — Context Engine from the Omarchy desktop.
#
# One key, kept in ~/.config/context-engine/config, reaches your engines over
# the engine's plain HTTP door (POST /tool/<name>). The same key is handed to
# every installed coding agent as an MCP server, so whichever agent Omarchy
# launches shares one memory.

set -euo pipefail

CE_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/context-engine"
CONFIG_FILE="$CONFIG_DIR/config"
# What ce wrote outside the plugin folder, one line each, so ce uninstall can
# undo exactly that: "made <path>" (did not exist before), "mode <path> <octal>"
# (permissions before ce tightened them), "agent <name>", "plugin enabled".
STATE_FILE="$CONFIG_DIR/installed"
SERVER_NAME="context-engine"
# Which computer a write came from, as the system names it (bash's $HOSTNAME
# is uname -n). Every write from ce carries it as a machine:<name> tag, so an
# engine shared by several machines can say which one saved what.
MACHINE_TAG="machine:$HOSTNAME"
# jq: the machine a found memory came from, or null; a memory's id across
# engines; a list of details joined into one line, empty ones left out.
JQ_DEFS='def machine: [(.fields.tags // [])[] | select(startswith("machine:")) | ltrimstr("machine:")] | first;
  def id: "\(.engine.slug)/\(.ref)";
  def meta: map(select(. != null and . != "")) | join(" · ");'

{ read -r VERSION && read -r PLUGIN_ID; } < <(jq -r '.version, .id' "$CE_DIR/manifest.json" 2>/dev/null) || true
VERSION=${VERSION:-dev} PLUGIN_ID=${PLUGIN_ID:-relote.context-engine}

CE_HOST="${CE_HOST:-}"
CE_KEY="${CE_KEY:-}"
CE_ENGINE="${CE_ENGINE:-}"

die() {
  echo "ce: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

ASSUME_YES=${ASSUME_YES:-0}

ask() {
  local question=$1
  ((ASSUME_YES)) && return 0
  interactive || return 1
  gum confirm "$question"
}

# rewrite <file> <command…>: replace the file's content with what the command
# prints, keeping its inode and mode. If the command fails, the file is left
# as it was. The staging file is private (mktemp makes it 0600), since the
# content may hold the key; an interrupt leaves it behind rather than risk
# deleting the only whole copy while the file is being written.
rewrite() {
  local file=$1 tmp status=0
  shift
  tmp=$(mktemp "$file.XXXXXX") || return 1
  "$@" >"$tmp" && cat "$tmp" >"$file" || status=1
  rm -f "$tmp"
  return $status
}

# without_line <line> <file>: the file minus that exact line (grep -v fails
# only when it cannot read, not when nothing is left).
without_line() {
  local status=0
  grep -vxF "$1" "$2" || status=$?
  ((status <= 1))
}

# end_line <file>: before appending, make sure the last line is ended.
end_line() {
  [[ -s $1 && $(tail -c1 "$1") != "" ]] && echo >>"$1"
  return 0
}

# strip_block <file> <begin> <end>: drop the lines between two markers, markers included.
strip_block() {
  [[ -f $1 ]] || return 0
  rewrite "$1" awk -v b="$2" -v e="$3" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip
  ' "$1"
}

remembered() {
  grep -qxF "$1" "$STATE_FILE" 2>/dev/null
}

# remember <line>: note something ce wrote, once.
remember() {
  [[ -d $CONFIG_DIR ]] || mkdirs "$CONFIG_DIR"
  remembered "$1" && return 0
  (
    umask 077
    printf '%s\n' "$1" >>"$STATE_FILE"
  )
}

forget() {
  [[ -f $STATE_FILE ]] || return 0
  rewrite "$STATE_FILE" without_line "$1" "$STATE_FILE"
}

# mkdir -p that remembers each directory it had to make, outermost first.
mkdirs() {
  local dir=$1 missing=()
  while [[ ! -d $dir ]]; do
    missing=("$dir" "${missing[@]}")
    dir=$(dirname "$dir")
  done
  ((${#missing[@]})) || return 0
  mkdir -p "$1"
  [[ $1 == "$CONFIG_DIR" ]] && chmod 700 "$CONFIG_DIR"
  for dir in "${missing[@]}"; do remember "made $dir"; done
}

# Before ce creates a file: its directory exists and the file is ours to remove.
new_file() {
  mkdirs "$(dirname "$1")"
  [[ -e $1 ]] || remember "made $1"
}

# Before ce tightens a file's permissions: what they were, once.
keep_mode() {
  [[ -e $1 ]] || return 0
  awk -v p="mode $1 " 'index($0, p) == 1 { found = 1 } END { exit !found }' "$STATE_FILE" 2>/dev/null ||
    remember "mode $1 $(stat -c %a "$1")"
}

# The config is KEY=value lines, read rather than sourced so a stray line can
# never run. The environment wins, so CE_KEY=… ce find … works for one call.
load_config() {
  local key value
  if [[ -f $CONFIG_FILE ]]; then
    while IFS='=' read -r key value; do
      case "$key" in
      CE_HOST) [[ -n $CE_HOST ]] || CE_HOST=$value ;;
      CE_KEY) [[ -n $CE_KEY ]] || CE_KEY=$value ;;
      CE_ENGINE) [[ -n $CE_ENGINE ]] || CE_ENGINE=$value ;;
      esac
    done <"$CONFIG_FILE"
  fi
  CE_HOST=${CE_HOST:-https://app.contextengine.com}
  CE_HOST=${CE_HOST%/}
}

save_config() {
  new_file "$CONFIG_FILE"
  (
    umask 077
    printf 'CE_HOST=%s\nCE_KEY=%s\nCE_ENGINE=%s\n' "$CE_HOST" "$CE_KEY" "$CE_ENGINE" >"$CONFIG_FILE"
  )
  chmod 600 "$CONFIG_FILE"
  refresh_bar
}

remove_config() {
  rm -f "$CONFIG_FILE"
  refresh_bar
}

# The bar icon reads ce status on a long timer; whenever the config changes
# its IPC handler is told at once. -q: no shell running, or no widget, is fine.
refresh_bar() {
  command -v omarchy-shell >/dev/null || return 0
  omarchy-shell -q "$PLUGIN_ID" refresh >/dev/null 2>&1 </dev/null || true
}

require_key() {
  [[ -n $CE_KEY ]] || die "not signed in. Run: ce login"
}

# POST /tool/<name> with a JSON body. Prints the envelope {text, data, isError}
# on success; on a refusal prints its text to stderr and fails.
# The key reaches curl through a file descriptor, never its arguments, so ps
# cannot show it.
tool() {
  local name=$1 body=${2:-'{}'} response status
  require_key
  response=$(curl -sS --max-time 60 -X POST "$CE_HOST/tool/$name" \
    -H @<(printf 'authorization: Bearer %s\n' "$CE_KEY") \
    -H "content-type: application/json" \
    -H "user-agent: omarchy-context-engine/$VERSION" \
    --data-binary "$body" -w $'\n%{http_code}') || die "could not reach $CE_HOST"
  status=${response##*$'\n'}
  response=${response%$'\n'*}

  if [[ $status == 401 ]]; then
    die "the key was refused (401). Make a new one and run: ce login"
  elif ((status >= 400)); then
    jq -r '.text // .error_description // .error // .' <<<"$response" >&2 2>/dev/null || echo "$response" >&2
    return 1
  fi
  echo "$response"
}

# The engine a write lands in: --engine, then the configured default.
engine_for_write() {
  local engine=${1:-$CE_ENGINE}
  [[ -n $engine ]] || die "no engine to save to. Pick one with: ce engine <slug>"
  echo "$engine"
}

cmd_login() {
  local key="" engine="" host=""
  while (($#)); do
    case "$1" in
    --key) key=${2:?--key needs a value}; shift 2 ;;
    --engine) engine=${2:?--engine needs a value}; shift 2 ;;
    --host) host=${2:?--host needs a value}; shift 2 ;;
    *) die "unexpected argument: $1" ;;
    esac
  done

  [[ -n $host ]] && CE_HOST=${host%/}

  # A key piped in (ce login <keyfile) stays off the command line.
  if [[ -z $key && ! -t 0 ]]; then
    key=$(cat)
  elif [[ -z $key ]]; then
    interactive || die "pipe the key in (ce login <keyfile), or run ce login in a terminal"
    cat <<EOF

Context Engine needs a key for this computer.

  1. Open $CE_HOST and sign in (an account is free).
  2. AI tools → Connect an AI tool → Your own code → Create my key.
     Give it "Can read and save" on the engines Omarchy should use.
  3. Paste the key (it starts with ce_) below.

EOF
    if command -v xdg-open >/dev/null && ask "Open $CE_HOST in your browser?"; then
      xdg-open "$CE_HOST/agents" >/dev/null 2>&1 &
    fi
    key=$(gum input --password --placeholder "ce_…" --prompt "Key: ") || die "cancelled"
  fi
  key=$(tr -d '[:space:]' <<<"$key")
  [[ -n $key ]] || die "no key given"

  CE_KEY=$key
  local brief
  brief=$(tool brief) || die "that key did not work against $CE_HOST"

  local engines writable
  engines=$(jq -c '[.data.engines[]? | {slug, name, access}]' <<<"$brief")
  writable=$(jq -r '.[] | select((.access // "") | test("write|save"; "i")) | .slug' <<<"$engines")

  if [[ -z $engine ]]; then
    if [[ $(wc -l <<<"$writable") -eq 1 && -n $writable ]]; then
      engine=$writable
    elif [[ -n $writable ]] && interactive; then
      engine=$(gum choose --header "Which engine should Omarchy save to by default?" $writable) || die "cancelled"
    else
      engine=$(jq -r '.[0].slug // empty' <<<"$engines")
    fi
  fi

  CE_ENGINE=$engine
  save_config
  echo "Signed in. Engines this key reaches:"
  jq -r '.[] | "  \(.slug)\t\(.name)\t(\(.access // "?"))"' <<<"$engines"
  [[ -n $CE_ENGINE ]] && echo "Saving to: $CE_ENGINE"
}

cmd_logout() {
  remove_config
  echo "Signed out. Claude Code stops reaching the engine now; other agents keep their own copy until: ce disconnect"
}

cmd_status() {
  local short=false
  [[ ${1:-} == --short ]] && short=true
  if [[ -z $CE_KEY ]]; then
    $short && echo "not-signed-in" || echo "Not signed in. Run: ce login"
    return 3
  fi
  local brief
  if ! brief=$(tool brief 2>/dev/null); then
    $short && echo "unreachable" || echo "Signed in, but $CE_HOST did not answer the key."
    return 2
  fi
  if $short; then
    echo "ok ${CE_ENGINE:-}"
  else
    echo "Host:    $CE_HOST"
    echo "Default: ${CE_ENGINE:-<none>}"
    echo "Engines:"
    jq -r '.data.engines[]? | "  \(.slug)\t\(.name)\t(\(.access // "?"))"' <<<"$brief"
    local changed
    changed=$(jq -r '(.data.changed // []) | length' <<<"$brief")
    echo "Changed since last visit: $changed"
  fi
}

cmd_engine() {
  if (($# == 0)); then
    echo "${CE_ENGINE:-}"
    return
  fi
  require_key
  CE_ENGINE=$1
  save_config
  echo "Saving to: $CE_ENGINE"
}

# ce brief: the engine's brief as agents read it (the skill's fallback when
# MCP is not there). ce brief --summary: what changed, for a person, from the
# same data: no instructions, no rules for agents.
cmd_brief() {
  local format=text
  case ${1:-} in
  --json) format=json ;;
  --summary) format=summary ;;
  esac
  local brief machines
  brief=$(tool brief)
  if [[ $format == json ]]; then
    jq '.data' <<<"$brief"
    return
  fi
  if [[ $format == text ]]; then
    jq -r '.text' <<<"$brief"
  fi
  machines=$(machines_of_changes "$brief")
  if [[ $format == summary ]]; then
    jq -r --argjson machines "$machines" "$JQ_DEFS"'.data as $d
      | (if $d.since then "Changed since you last looked (\($d.since[0:10])):"
         else "Most recent (no earlier visit on record):" end),
        (if ($d.changed // []) == [] then "  Nothing new." else empty end),
        ($d.changed[]? | "",
          "• \(.title // .ref)",
          "  " + ([.type, (.engine.name // .engine.slug), (.updated // "")[0:10],
                   (.change | select(.person) | "\(.act) by \(.person)"),
                   ($machines[id] | select(.) | "from \(.)")] | meta)),
        (if ($d.omitted // 0) > 0 then "", "…and \($d.omitted) more." else empty end),
        (($d.unanswered // [])[] | "", "\(.name) did not answer."),
        ($d.usage // empty | "", .)
    ' <<<"$brief"
    return
  fi
  jq -r --argjson machines "$machines" "$JQ_DEFS"'
    [.data.changed[]? | {ref, machine: $machines[id]} | select(.machine)]
    | if length > 0 then "\nFrom which machine:", (.[] | "  \(.ref)  ←  \(.machine)") else empty end
  ' <<<"$brief"
}

# machines_of_changes <brief>: {"engine/ref": machine} for the changes it
# lists. The brief carries no tags, so they are read back from the most
# recent memories' machine: tags.
machines_of_changes() {
  local changed recent
  changed=$(jq -c "$JQ_DEFS"'[.data.changed[]? | id]' <<<"$1")
  if [[ $changed == '[]' ]] || ! recent=$(tool find '{"limit": 50}' 2>/dev/null); then
    echo '{}'
    return
  fi
  jq -c --argjson changed "$changed" "$JQ_DEFS"'
    [.data.hits[]? | {key: id, value: machine}
      | select(.value) | select(.key as $id | $changed | index($id))]
    | from_entries
  ' <<<"$recent"
}

cmd_find() {
  local json=false styled=false limit=8 engine="" types=()
  local words=()
  while (($#)); do
    case "$1" in
    --json) json=true; shift ;;
    --styled) styled=true; shift ;;
    --limit|-n) limit=${2:?}; shift 2 ;;
    --engine|-e) engine=${2:?}; shift 2 ;;
    --type|-t) types+=("${2:?}"); shift 2 ;;
    *) words+=("$1"); shift ;;
    esac
  done
  local q="${words[*]:-}"
  local body
  body=$(jq -nc --arg q "$q" --arg engine "$engine" --argjson limit "$limit" \
    --args '{limit: $limit}
      + (if $q != "" then {q: $q} else {} end)
      + (if $engine != "" then {engine: $engine} else {} end)
      + (if ($ARGS.positional | length) > 0 then {type: $ARGS.positional} else {} end)' \
    "${types[@]}")
  local result
  result=$(tool find "$body")
  if $json; then
    jq '.data' <<<"$result"
  elif $styled; then
    # For the overlay, in Qt's StyledText (the HTML subset whose links take
    # the theme's colour): a linked title, where it lives, the start of the
    # body. Engine text is escaped, and only an http(s) url becomes a link.
    jq -r "$JQ_DEFS"'
      def esc: gsub("&"; "&amp;") | gsub("<"; "&lt;") | gsub(">"; "&gt;") | gsub("\""; "&quot;");
      .data.hits // [] | if length == 0 then "Nothing found." else map(
        ((.title // .ref // "") | esc) as $title
        | "<b>" + (if (.url // "") | test("^https?://") then "<a href=\"\(.url | esc)\">\($title)</a>" else $title end) + "</b><br>"
          + "<i>" + ([.type, (.engine.name // .engine.slug), (.updated_at // "")[0:10], (machine | select(.) | "machine:" + .)]
              | meta | esc) + "</i><br>"
          + ((.body // "") | gsub("\\s+"; " ") | .[0:220] | esc)
      ) | join("<br><br>") end' <<<"$result"
  else
    jq -r '.text' <<<"$result"
  fi
}

cmd_get() {
  local ref=${1:?usage: ce get <type::slug> [--engine slug]} engine=""
  shift
  [[ ${1:-} == --engine || ${1:-} == -e ]] && engine=${2:?}
  engine=$(engine_for_write "$engine")
  tool get "$(jq -nc --arg ref "$ref" --arg engine "$engine" '{ref: $ref, engine: $engine}')" | jq -r '.text'
}

# ce remember [--type note|decision|task] [--title T] [--why R] [--tag t]… [text…]
# Text may come on stdin. With no title, the first line is the title.
cmd_remember() {
  local type=note title="" why="" engine="" quiet=false notify=false tags=() words=()
  while (($#)); do
    case "$1" in
    --type|-t) type=${2:?}; shift 2 ;;
    --decision) type=decision; shift ;;
    --task) type=task; shift ;;
    --title) title=${2:?}; shift 2 ;;
    --why) why=${2:?}; shift 2 ;;
    --tag) tags+=("${2:?}"); shift 2 ;;
    --engine|-e) engine=${2:?}; shift 2 ;;
    --quiet|-q) quiet=true; shift ;;
    --notify) notify=true; shift ;;
    *) words+=("$1"); shift ;;
    esac
  done

  # ce remember "Title" "body…": several arguments are a title and a body.
  if [[ -z $title && ${#words[@]} -gt 1 ]]; then
    title=${words[0]}
    words=("${words[@]:1}")
  fi
  local text="${words[*]:-}"
  if [[ -z $text && ! -t 0 ]]; then
    text=$(cat)
  fi
  [[ -n ${text//[[:space:]]/} ]] || die "nothing to remember"

  local body=$text
  if [[ -z $title ]]; then
    title=$(head -n1 <<<"$text" | sed -E 's/^[#[:space:]]+//' | cut -c1-80)
    [[ $(wc -l <<<"$text") -gt 1 ]] && body=$(tail -n +2 <<<"$text" | sed -e '/./,$!d')
  fi
  [[ -n $body ]] || body=$title
  if [[ $type == decision && -z $why ]]; then
    why=$body
  fi

  engine=$(engine_for_write "$engine")
  local idem
  idem=$(printf '%s\n%s\n%s' "$type" "$title" "$body" | sha256sum | cut -c1-32)

  local result
  payload() {
    jq -nc --arg engine "$engine" --arg type "$type" --arg title "$1" --arg body "$body" \
      --arg why "$why" --arg idem "$idem" --arg machine "$MACHINE_TAG" \
      --args '{engine: $engine, type: $type, title: $title, body: $body, idem: $idem,
        tags: (["omarchy", $machine] + $ARGS.positional | unique)}
        + (if $why != "" then {fields: {rationale: $why}} else {} end)' \
      "${tags[@]}"
  }

  # A title is the record's id, so a second note with the same first line is
  # refused rather than merged. Date it and try once more.
  # tool is silent on stderr when it succeeds, so 2>&1 only ever adds a refusal.
  local err
  if ! result=$(tool write "$(payload "$title")" 2>&1); then
    err=$result
    if grep -qi "title\|taken\|already" <<<"$err"; then
      if ! result=$(tool write "$(payload "$title ($(date '+%Y-%m-%d %H:%M'))")" 2>&1); then
        echo "$result" >&2
        $notify && notify-send -a "Context Engine" "Not saved" "${result:0:200}"
        exit 1
      fi
    else
      echo "$err" >&2
      $notify && notify-send -a "Context Engine" "Not saved" "${err:0:200}"
      exit 1
    fi
  fi

  local ref
  ref=$(jq -r '.data.ref // .data.record.ref // empty' <<<"$result")
  $quiet || echo "Saved ${ref:-memory} to $engine"
  $notify && notify-send -a "Context Engine" "Remembered" "$title"
  return 0
}

# Questions go to Omarchy's default agent, which reads the engine over MCP.
# Before handing one over, make sure that agent is actually connected: the
# default can change after setup, and a new agent starts without the server.
cmd_ensure_agent() {
  require_key
  source "$CE_DIR/lib/agents.sh"
  local agent
  agent=$(omarchy-default-agent 2>/dev/null || true)
  [[ -n $agent ]] || return 0
  valid_agent "$agent" && agent_installed "$agent" || return 0
  "${agent}_connected" || { "${agent}_connect" </dev/null && remember "agent $agent"; }
}

# For agents that ask for headers when they connect (Claude Code's
# headersHelper): the key stays in this computer's config, not in theirs.
cmd_mcp_headers() {
  require_key
  CE_AUTH="Bearer $CE_KEY" jq -nc '{Authorization: env.CE_AUTH}'
}

cmd_tool() {
  local name=${1:?usage: ce tool <name> [json]}
  tool "$name" "${2:-{\}}" | jq .
}

cmd_mcp_url() {
  echo "$CE_HOST/mcp"
}

usage() {
  cat <<EOF
ce $VERSION — Context Engine on Omarchy

Usage: ce <command> [args]

  setup [--yes]         Sign in, connect agents, install the skill and menu
  uninstall             Undo everything setup and connect wrote, key included
  login [<keyfile]      Store a key for this computer (asks, or reads stdin)
  logout                Forget the key
  status [--short]      Is this computer connected, and to what
  engine [slug]         Show or set the engine new memories go to

  brief [--summary]     What changed since you last looked (--json: raw)
  find [query]          Search memory (no query: most recent)
  get <type::slug>      Open one memory
  remember [text]       Save a note (stdin works; --decision --why, --task, --tag)

  connect [agent…]      Give coding agents the engine over MCP
  disconnect [agent…]   Remove it again
  agents                Which agents are installed and connected
  open                  Open the engine console in the browser
  tool <name> [json]    Call any engine tool raw

Agents: claude codex opencode hermes cursor gemini
EOF
}

main() {
  load_config
  local command=${1:-help}
  (($#)) && shift
  case "$command" in
  login) cmd_login "$@" ;;
  logout) cmd_logout ;;
  status) cmd_status "$@" ;;
  engine) cmd_engine "$@" ;;
  brief) cmd_brief "$@" ;;
  find | search) cmd_find "$@" ;;
  get) cmd_get "$@" ;;
  remember | save | note) cmd_remember "$@" ;;
  ensure-agent) cmd_ensure_agent ;;
  tool) cmd_tool "$@" ;;
  mcp-url) cmd_mcp_url ;;
  mcp-headers) cmd_mcp_headers ;;
  open) xdg-open "$CE_HOST" >/dev/null 2>&1 & ;;
  connect | disconnect | agents)
    source "$CE_DIR/lib/agents.sh"
    "agents_$command" "$@"
    ;;
  setup | uninstall)
    source "$CE_DIR/lib/agents.sh"
    source "$CE_DIR/lib/setup.sh"
    "setup_$command" "$@"
    ;;
  version | --version) echo "$VERSION" ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"
